# LLM (switchable — any OpenAI-compatible provider)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_REASONING=gpt-4o

# Search
TAVILY_API_KEY=tvly-...

# AI Media Detection (SightEngine)
SIGHTENGINE_API_USER=your_api_user
SIGHTENGINE_API_SECRET=your_api_secret

# InsForge (run `insforge link` to get these)
INSFORGE_URL=https://your-app.region.insforge.app
INSFORGE_API_KEY=ik_...

# App
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
